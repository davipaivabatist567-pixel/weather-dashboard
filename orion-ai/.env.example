# Copie para .env e preencha. NUNCA versione o arquivo .env.
# Chave da API da Anthropic (Claude). Sem ela, o Orion roda em "modo local limitado".
ANTHROPIC_API_KEY=
# Modelo usado pela inteligência central (padrão: claude-opus-5-5)
ORION_MODEL=claude-opus-5-5
# Esforço de raciocínio: low | medium | high | xhigh | max
ORION_EFFORT=medium
# Pesquisa na internet via ferramenta web_search da Anthropic (true/false)
ORION_WEB_SEARCH=true
# Porta e host do backend (por padrão escuta apenas localmente)
ORION_PORT=8787
ORION_HOST=127.0.0.1
